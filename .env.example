# Copy this file to .env and fill in your own values. Never commit .env.

# ---- Bring your own AI ----
# Any LiteLLM model string. Examples:
#   anthropic/claude-haiku-5-5
#   openai/<model-name>
#   azure/<your-deployment-name>   (also set LLM_API_BASE)
#   gemini/<model-name>
#   bedrock/<model-id>             (uses your AWS credentials)
#   ollama/<model-name>            (set LLM_API_BASE=http://localhost:11434, no key needed)
LLM_MODEL=anthropic/claude-haiku-5-5
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0

# ---- Spending and rate limits ----
SPEND_CAP_USD=5
RATE_LIMIT_PER_MINUTE=30

# ---- Postgres (shared by Zammad and the copilot, separate databases) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
COPILOT_DB_PASSWORD=change-me-too
ZAMMAD_DB_PASSWORD=change-me-three
DATABASE_URL=postgresql://copilot:change-me-too@localhost:5432/copilot

# ---- Zammad ----
ZAMMAD_URL=http://localhost:8080
# Used by scripts/bootstrap_zammad.py to create the first admin account.
ZAMMAD_ADMIN_EMAIL=admin@northgate-ms.example
ZAMMAD_ADMIN_PASSWORD=Change-Me-To-Something-L0ng
# Printed by scripts/bootstrap_zammad.py, or create one under Profile > Token Access.
ZAMMAD_TOKEN=

# ---- Mailpit (local test mail server) ----
SMTP_HOST=localhost
SMTP_PORT=1025
# Zammad fetches mail from Mailpit over POP3 with these credentials.
MAILPIT_POP3_USER=zammad
MAILPIT_POP3_PASSWORD=change-me-four
